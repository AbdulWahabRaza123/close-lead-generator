# Close CRM API key (Settings → Developer → API Keys)
CLOSE_API_KEY=your_api_key_here

# Optional: Lead custom field IDs for founded date (Date) and revenue (Number).
# Create these in Close under Settings → Custom Fields → Lead, then paste IDs here.
# If omitted, founded/revenue are stored in lead description for reporting fallback.
CLOSE_CF_FOUNDED_DATE=
CLOSE_CF_REVENUE=

# Optional: set to "true" to simulate API calls without writing to Close (development only)
DRY_RUN=false

# After import, reports filter to this batch + output/import_manifest.json (use --all-org-leads to disable)
